# Environment Configuration Example for FamilyRoots Backend

# Application Settings
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/familyroots?schema=public"

# Authentication Secrets
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_SECRET="your-super-secret-refresh-key-change-in-production"
REFRESH_TOKEN_EXPIRATION="7d"

# Redis Cache & Queue Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL=""
REDIS_ENABLED="true"

# SMTP Email Dispatcher (Leave blank to output OTP codes to server console during development)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_SECURE="false"
EMAIL_FROM="\"FamilyRoots\" <noreply@familyroots.app>"
