        .badge-post { background-color: #dcfce7; color: #15803d; }
        .badge-patch { background-color: #fef3c7; color: #b45309; }
        .badge-delete { background-color: #fee2e2; color: #b91c1c; }
        .info-box {
            background-color: #eff6ff;
